generator client {
    provider = "prisma-client"
    output   = "../generated/prisma"
}

datasource db {
    provider = "postgresql"
}

// ──────────────────────────────────────────────
// Auth & Access (NextAuth.js v5 + RBAC)
// ──────────────────────────────────────────────

model User {
    id            String    @id @default(cuid())
    name          String?
    email         String?   @unique
    emailVerified DateTime?
    image         String?
    hashedPassword String?
    isActive      Boolean   @default(true)
    createdAt     DateTime  @default(now())
    updatedAt     DateTime  @updatedAt

    accounts         Account[]
    sessions         Session[]
    roles            UserRole[]
    auditLogs        AuditLogEntry[]        @relation("AuditActor")
    stockAdjustments StockLedgerEntry[]     @relation("StockActor")
    statusChanges    OrderStatusHistory[]   @relation("StatusActor")
    refundsInitiated Refund[]              @relation("RefundInitiator")
    returnActions    Return[]              @relation("RefundActor")
    uploadedMedia    MediaAsset[]          @relation("MediaUploader")
    customerNotes    CustomerNote[]        @relation("NoteAuthor")
}

model Account {
    id                String  @id @default(cuid())
    userId            String
    type              String
    provider          String
    providerAccountId String
    password          String? // BetterAuth stores password hash here
    refresh_token     String? @db.Text
    access_token      String? @db.Text
    expires_at        Int?
    token_type        String?
    scope             String?
    id_token          String? @db.Text
    session_state     String?

    user User @relation(fields: [userId], references: [id], onDelete: Cascade)

    @@unique([provider, providerAccountId])
}

model Session {
    id           String   @id @default(cuid())
    sessionToken String   @unique @map("session_token")
    userId       String   @map("user_id")
    expires      DateTime
    ipAddress    String?  @map("ip_address")
    userAgent    String?  @map("user_agent")
    createdAt    DateTime @default(now()) @map("created_at")
    updatedAt    DateTime @updatedAt @map("updated_at")
    user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
    identifier String
    token      String   @unique
    expires    DateTime

    @@unique([identifier, token])
}

model Role {
    id          String       @id @default(cuid())
    name        String       @unique @db.VarChar(50)
    description String?
    guardName   String       @default("web")
    isSystem    Boolean      @default(false)
    createdAt   DateTime     @default(now())
    updatedAt   DateTime     @updatedAt

    users       UserRole[]
    permissions RolePermission[]
}

model Permission {
    id          String       @id @default(cuid())
    resource    String       @db.VarChar(50)
    action      String       @db.VarChar(50)
    description String?
    createdAt   DateTime     @default(now())

    roles       RolePermission[]

    @@unique([resource, action])
}

model RolePermission {
    roleId       String
    permissionId String

    role       Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
    permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

    @@id([roleId, permissionId])
}

model UserRole {
    userId String
    roleId String

    user User @relation(fields: [userId], references: [id], onDelete: Cascade)
    role Role @relation(fields: [roleId], references: [id], onDelete: Cascade)

    @@id([userId, roleId])
}

model AuditLogEntry {
    id         String   @id @default(cuid())
    actorId    String?
    action     String   @db.VarChar(100)
    entityType String   @db.VarChar(50)
    entityId   String?
    before     Json?
    after      Json?
    ipAddress  String?  @db.VarChar(45)
    timestamp  DateTime @default(now())

    actor User? @relation("AuditActor", fields: [actorId], references: [id], onDelete: SetNull)

    @@index([entityType, entityId])
    @@index([timestamp])
    @@index([action])
}

// ──────────────────────────────────────────────
// Customers
// ──────────────────────────────────────────────

model Customer {
    id        String   @id @default(cuid())
    name      String   @db.VarChar(200)
    email     String?  @unique
    phone     String?  @db.VarChar(30)
    notes     String?  @db.Text
    flags     String[] // VIP, fraud-risk
    createdAt DateTime @default(now())
    updatedAt DateTime @updatedAt

    addresses   Address[]
    orders      Order[]             @relation("CustomerOrders")
    customerNotes CustomerNote[]
}

model Address {
    id         String  @id @default(cuid())
    customerId String
    type       String  @default("shipping") // billing, shipping
    line1      String  @db.VarChar(255)
    line2      String? @db.VarChar(255)
    city       String  @db.VarChar(100)
    state      String  @db.VarChar(100)
    postalCode String  @db.VarChar(20)
    country    String  @db.VarChar(100)
    isDefault  Boolean @default(false)

    customer Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
}

model CustomerNote {
    id         String   @id @default(cuid())
    customerId String
    authorId   String?
    note       String   @db.Text
    createdAt  DateTime @default(now())

    customer Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
    author   User?    @relation("NoteAuthor", fields: [authorId], references: [id], onDelete: SetNull)
}

// ──────────────────────────────────────────────
// Catalog
// ──────────────────────────────────────────────

model Category {
    id          String     @id @default(cuid())
    name        String     @db.VarChar(100)
    slug        String     @unique @db.VarChar(120)
    description String?    @db.Text
    parentId    String?
    sortOrder   Int        @default(0)
    imageUrl    String?
    createdAt   DateTime   @default(now())
    updatedAt   DateTime   @updatedAt

    parent    Category?       @relation("CategoryParent", fields: [parentId], references: [id], onDelete: SetNull)
    children  Category[]      @relation("CategoryParent")
    products  Product[]
    media     CategoryMedia[]
}

model Supplier {
    id           String   @id @default(cuid())
    name         String   @db.VarChar(200)
    contactName  String?  @db.VarChar(100)
    email        String?  @db.VarChar(255)
    phone        String?  @db.VarChar(30)
    leadTimeDays Int?
    notes        String?  @db.Text
    createdAt    DateTime @default(now())
    updatedAt    DateTime @updatedAt

    products Product[]
}

model Product {
    id          String   @id @default(cuid())
    name        String   @db.VarChar(200)
    slug        String   @unique @db.VarChar(255)
    sku         String?  @unique @db.VarChar(100)
    brand       String?  @db.VarChar(100)
    description String?  @db.Text
    specifications Json? // structured key-value: impedance, frequency response, etc.
    basePrice   Float
    costPrice   Float?
    taxClass    String?  @db.VarChar(50)
    weight      Float?
    dimensions  Json?    // {length, width, height, unit}
    status      String   @default("draft") // draft, active, archived
    categoryId  String?
    supplierId  String?
    createdAt   DateTime @default(now())
    updatedAt   DateTime @updatedAt

    category  Category?  @relation(fields: [categoryId], references: [id], onDelete: SetNull)
    supplier  Supplier?  @relation(fields: [supplierId], references: [id], onDelete: SetNull)
    features  String[]         // paragraphs of feature description
    box       Json?            // [{name: "Headphone Unit", quantity: 1}, ...]
    variants  ProductVariant[]
    media     ProductMedia[]
    bundles   Bundle[]         @relation("BundleProduct")

    @@index([status])
    @@index([categoryId])
}

model ProductVariant {
    id               String   @id @default(cuid())
    productId        String
    sku              String   @unique @db.VarChar(100)
    name             String   @db.VarChar(200)
    priceDelta       Float    @default(0)
    stock            Int      @default(0)
    lowStockThreshold Int     @default(5)
    weightDelta      Float?
    isActive         Boolean  @default(true)
    createdAt        DateTime @default(now())
    updatedAt        DateTime @updatedAt

    product      Product            @relation(fields: [productId], references: [id], onDelete: Cascade)
    media        ProductMedia[]
    stockLedger  StockLedgerEntry[]
    orderItems   OrderLineItem[]
    bundleItems  Bundle[]           @relation("BundleComponentVariant")
}

model Bundle {
    id                       String   @id @default(cuid())
    productId                String
    componentVariantId       String
    quantity                 Int      @default(1)
    decrementComponentStock  Boolean  @default(true)
    createdAt                DateTime @default(now())
    updatedAt                DateTime @updatedAt

    product       Product        @relation("BundleProduct", fields: [productId], references: [id], onDelete: Cascade)
    component     ProductVariant @relation("BundleComponentVariant", fields: [componentVariantId], references: [id], onDelete: Cascade)

    @@unique([productId, componentVariantId])
}

model MediaAsset {
    id          String   @id @default(cuid())
    url         String   @db.Text
    filename    String   @db.VarChar(255)
    mimeType    String   @db.VarChar(50)
    sizeBytes   Int
    variants    Json?    // {thumbnail, medium, desktop, original} -> urls
    altText     String?  @db.Text
    tags        String[]
    folder      String?  @db.VarChar(100)
    width       Int?
    height      Int?
    uploadedById String?
    createdAt   DateTime @default(now())
    updatedAt   DateTime @updatedAt

    uploadedBy User?          @relation("MediaUploader", fields: [uploadedById], references: [id], onDelete: SetNull)
    products   ProductMedia[]
    categories CategoryMedia[]

    @@unique([folder, filename], name: "folder_filename")
}

model CategoryMedia {
    id           String   @id @default(cuid())
    categoryId   String
    mediaAssetId String
    displayOrder Int      @default(0)
    isPrimary    Boolean  @default(false)
    purpose      String   @default("default")
    createdAt    DateTime @default(now())

    category   Category   @relation(fields: [categoryId], references: [id], onDelete: Cascade)
    mediaAsset MediaAsset @relation(fields: [mediaAssetId], references: [id], onDelete: Cascade)

    @@unique([categoryId, mediaAssetId])
}

model ProductMedia {
    id            String  @id @default(cuid())
    productId     String
    variantId     String?
    mediaAssetId  String
    displayOrder  Int     @default(0)
    isPrimary     Boolean @default(false)
    purpose       String  @default("default") // default, gallery, featured

    product    Product     @relation(fields: [productId], references: [id], onDelete: Cascade)
    variant    ProductVariant? @relation(fields: [variantId], references: [id], onDelete: Cascade)
    mediaAsset MediaAsset  @relation(fields: [mediaAssetId], references: [id], onDelete: Cascade)

    @@unique([productId, mediaAssetId, purpose, variantId])
}

// ──────────────────────────────────────────────
// Stock & Warehouse
// ──────────────────────────────────────────────

model StockLedgerEntry {
    id              String   @id @default(cuid())
    variantId       String
    delta           Int      // positive = restock, negative = sale/adjustment
    reason          String   @db.VarChar(50) // restock, sale, adjustment, return, damaged, correction
    reasonDetail    String?  @db.Text
    actorId         String?
    referenceType   String?  @db.VarChar(50) // order, adjustment, return
    referenceId     String?
    beforeQuantity  Int
    afterQuantity   Int
    timestamp       DateTime @default(now())

    variant ProductVariant @relation(fields: [variantId], references: [id], onDelete: Cascade)
    actor   User?          @relation("StockActor", fields: [actorId], references: [id], onDelete: SetNull)

    @@index([variantId, timestamp])
}

// ──────────────────────────────────────────────
// Orders & Fulfillment
// ──────────────────────────────────────────────

enum OrderStatus {
    pending_payment
    paid
    processing
    shipped
    delivered
    cancelled
    refunded
    partially_refunded
}

model Order {
    id               String      @id @default(cuid())
    customerId       String?
    status           OrderStatus @default(pending_payment)
    subtotal         Float       @default(0)
    shippingCost     Float       @default(0)
    taxAmount        Float       @default(0)
    discountAmount   Float       @default(0)
    total            Float       @default(0)
    currency         String      @default("USD")
    notes            String?     @db.Text
    source           String      @default("customer") // customer, staff
    staffCreatorId   String?
    createdByCustomer Boolean   @default(true)
    createdAt        DateTime    @default(now())
    updatedAt        DateTime    @updatedAt

    customer     Customer?          @relation("CustomerOrders", fields: [customerId], references: [id], onDelete: SetNull)
    items        OrderLineItem[]
    statusHistory OrderStatusHistory[]
    payments     Payment[]
    shipments    Shipment[]
    returns      Return[]

    @@index([status, createdAt])
    @@index([customerId])
}

model OrderLineItem {
    id            String  @id @default(cuid())
    orderId       String
    variantId     String?
    quantity      Int
    unitPrice     Float
    lineTotal     Float
    isGiftWrapped Boolean @default(false)

    order   Order           @relation(fields: [orderId], references: [id], onDelete: Cascade)
    variant ProductVariant? @relation(fields: [variantId], references: [id], onDelete: SetNull)

    shipmentItems ShipmentItem[]
}

model OrderStatusHistory {
    id         String   @id @default(cuid())
    orderId    String
    fromStatus String?  @db.VarChar(50)
    toStatus   String   @db.VarChar(50)
    actorId    String?
    note       String?  @db.Text
    timestamp  DateTime @default(now())

    order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)
    actor User? @relation("StatusActor", fields: [actorId], references: [id], onDelete: SetNull)
}

model Shipment {
    id            String   @id @default(cuid())
    orderId       String
    trackingNumber String? @db.VarChar(200)
    carrier       String?  @db.VarChar(100)
    shippedAt     DateTime?
    deliveredAt   DateTime?
    createdAt     DateTime @default(now())

    order Order            @relation(fields: [orderId], references: [id], onDelete: Cascade)
    items ShipmentItem[]
}

model ShipmentItem {
    id           String @id @default(cuid())
    shipmentId   String
    lineItemId   String
    quantity     Int

    shipment Shipment      @relation(fields: [shipmentId], references: [id], onDelete: Cascade)
    lineItem OrderLineItem @relation(fields: [lineItemId], references: [id], onDelete: Cascade)

    @@unique([shipmentId, lineItemId])
}

model Return {
    id          String   @id @default(cuid())
    orderId     String
    reason      String   @db.Text
    status      String   @default("requested") // requested, approved, rejected, restocked
    refundAmount Float   @default(0)
    restocked   Boolean  @default(false)
    actorId     String?
    createdAt   DateTime @default(now())
    updatedAt   DateTime @updatedAt

    order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)
    actor User? @relation("RefundActor", fields: [actorId], references: [id], onDelete: SetNull)
}

// ──────────────────────────────────────────────
// Payments
// ──────────────────────────────────────────────

model PSPConnection {
    id                  String   @id @default(cuid())
    provider            String   @db.VarChar(50) // stripe, paystack
    label               String   @db.VarChar(100)
    credentials         Json     // encrypted: {api_key, webhook_secret, ...}
    isEnabled           Boolean  @default(true)
    isDefault           Boolean  @default(false)
    priorityOrder       Int      @default(0)
    restrictedCurrencies String[]
    restrictedRegions   String[]
    liveMode            Boolean  @default(false)
    createdAt           DateTime @default(now())
    updatedAt           DateTime @updatedAt

    payments     Payment[]
    webhookEvents WebhookEvent[]
}

model Payment {
    id                 String   @id @default(cuid())
    orderId            String
    pspConnectionId    String?
    provider           String   @db.VarChar(50)
    pspPaymentIntentId String?  @db.VarChar(255)
    amount             Float
    currency           String   @default("USD")
    status             String   @default("pending") // succeeded, failed, pending, disputed, chargeback
    metadata           Json?
    createdAt          DateTime @default(now())
    updatedAt          DateTime @updatedAt

    order    Order         @relation(fields: [orderId], references: [id], onDelete: Cascade)
    psp      PSPConnection? @relation(fields: [pspConnectionId], references: [id], onDelete: SetNull)
    refunds  Refund[]
}

model Refund {
    id           String   @id @default(cuid())
    paymentId    String
    pspRefundId  String?  @db.VarChar(255)
    amount       Float
    currency     String   @default("USD")
    reason       String?  @db.Text
    status       String   @default("pending") // pending, succeeded, failed
    initiatedById String?
    createdAt    DateTime @default(now())
    updatedAt    DateTime @updatedAt

    payment  Payment @relation(fields: [paymentId], references: [id], onDelete: Cascade)
    initiator User?   @relation("RefundInitiator", fields: [initiatedById], references: [id], onDelete: SetNull)
}

model WebhookEvent {
    id              String    @id @default(cuid())
    pspConnectionId String?
    provider        String    @db.VarChar(50)
    eventType       String    @db.VarChar(100)
    pspEventId      String?   @db.VarChar(255)
    rawBody         Json?
    headers         Json?
    status          String    @default("received") // received, processed, failed, skipped
    errorMessage    String?   @db.Text
    processedAt     DateTime?
    createdAt       DateTime  @default(now())

    psp PSPConnection? @relation(fields: [pspConnectionId], references: [id], onDelete: SetNull)
}
